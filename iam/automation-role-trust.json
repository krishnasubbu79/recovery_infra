{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Principal": { "Service": "ssm.amazonaws.com" },
    "Action": "sts:AssumeRole",
    "Condition": {
      "StringEquals": { "aws:SourceAccount": "__ACCOUNT_ID__" },
      "ArnLike": { "aws:SourceArn": "arn:aws:ssm:*:__ACCOUNT_ID__:automation-execution/*" }
    }
  }]
}
