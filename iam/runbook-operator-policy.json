{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageAndStartRecoveryRunbooks",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:UpdateDocument",
        "ssm:UpdateDocumentDefaultVersion",
        "ssm:GetDocument",
        "ssm:DescribeDocument",
        "ssm:StartAutomationExecution"
      ],
      "Resource": [
        "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:document/Recovery-Deploy*",
        "arn:aws:ssm:__REGION__:__ACCOUNT_ID__:automation-definition/Recovery-Deploy*:*"
      ]
    },
    {
      "Sid": "WatchExecutions",
      "Effect": "Allow",
      "Action": [
        "ssm:GetAutomationExecution",
        "ssm:DescribeAutomationExecutions",
        "ssm:DescribeAutomationStepExecutions",
        "ssm:StopAutomationExecution"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassAutomationRoleToSsm",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/RecoveryAutomationRole",
      "Condition": { "StringEquals": { "iam:PassedToService": "ssm.amazonaws.com" } }
    }
  ]
}
